{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shaughn0419/NODI-Simulation-Foundation/schemas/pair_schema.json",
  "title": "NODI Foundation one-axis intervention pair v5 exact dry-etch support",
  "type": "object",
  "additionalProperties": false,
  "required": ["pair_id", "physics_profile_id", "anchor_state_id", "anchor_reference_design_id", "anchor_split_group_id", "feature", "low_state_id", "high_state_id", "low_split_group_id", "high_split_group_id", "delta_S_W", "delta_C_r_W", "delta_C_i_W", "delta_Y_0_W"],
  "properties": {
    "pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "physics_profile_id": {"enum": ["FORMAL_FIELD_COUPLING_M1_V5_EXACT_SUPPORT", "FAST_SCALING_CONTROL_V1"]},
    "anchor_state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anchor_reference_design_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "anchor_split_group_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "feature": {"type": "string"},
    "low_value": {"type": "number"},
    "high_value": {"type": "number"},
    "low_state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "high_state_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "low_split_group_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "high_split_group_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "low_S_W": {"type": "number"},
    "high_S_W": {"type": "number"},
    "delta_S_W": {"type": "number"},
    "low_C_r_W": {"type": "number"},
    "high_C_r_W": {"type": "number"},
    "delta_C_r_W": {"type": "number"},
    "low_C_i_W": {"type": "number"},
    "high_C_i_W": {"type": "number"},
    "delta_C_i_W": {"type": "number"},
    "low_Y_0_W": {"type": "number"},
    "high_Y_0_W": {"type": "number"},
    "delta_Y_0_W": {"type": "number"}
  }
}
